# Copy this file to android/key.properties and fill in real values.
# Generate the keystore with: powershell -File scripts/create_release_keystore.ps1
#
# NOTE: NEVER commit the real key.properties or the .jks keystore to version control.
# Add these lines to .gitignore:
#   android/key.properties
#   *.jks

storePassword=YOUR_STORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=upload
storeFile=upload-keystore.jks